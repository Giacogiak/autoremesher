		"promptNotes": [
			{
				"text": "## Toolchain\n\nThis host has no C/C++ compiler, no TBB dev package and no .NET SDK. Run every build/test/dotnet command inside the existing toolbox container: `toolbox run -c instant-meshes-build -- <command>` (it already has gcc-c++, cmake and dotnet-sdk-8.0 installed). Do not attempt to install anything system-wide with sudo — there is no passwordless sudo here. TBB itself must be built from this repo's own vendored `thirdparty/tbb` source via CMake `add_subdirectory` (see M1 Task 1's plan text for the exact pattern, copied from the sibling Instant Meshes P/Invoke project) — never from a system `tbb-devel` package, which is not installed and cannot be installed without a password."
			}
		],
		"gitPolicy": {
			"noPush": true
		},
		"stopUnits": [
			"M4"
		],
		"stopUnitsWhy": {
			"M4": "D5 (scoring metric weighting) is open — see plan/01_decisions.md. It needs M3's real score distributions across the sweep before it can be answered; a guessed weighting risks ranking trials on the wrong thing."
		},
