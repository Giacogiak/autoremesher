<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console demo of the autoremesher_core shared library (src/autoremesher_core_api.h)
       over P/Invoke.  Build the native library with CMake first, then dotnet run; see
       README.md.  No NuGet packages, so it builds offline. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoRemesherDemo</AssemblyName>
    <RootNamespace>AutoRemesherDemo</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The test runner has its own project in tests/. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
